import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int side = sc.nextInt(); 
        int tiles = sc.nextInt();
        int t = (int)Math.sqrt(tiles);
        int a = side * t;
        System.out.println(a*a);
    }
}
