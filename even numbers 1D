package array_based_problems;

import java.util.Scanner;

public class EvenNumbers {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        int n = sc.nextInt();
        int arr[] = new int[n];
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }
        for (int i = 0; i < n; i++) {
            if ((arr[i]&1) == 0) {
                System.out.print(arr[i] + " ");
            }
        }
        
        sc.close();
    }
}
