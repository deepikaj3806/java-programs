package two_D_basedproblems;

import java.util.Scanner;

public class MaximumSumRow {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner sc  =new Scanner(System.in);
		int r=sc.nextInt();
		int c=sc.nextInt();
		int arr[][] = new int[r][c];
		for(int i=0;i<r;i++) {
			for(int j=0;j<c;j++) {
				arr[i][j]=sc.nextInt();
			}
		}
		int max=Integer.MIN_VALUE;
		int row=-1; 
		for(int i=0;i<r;i++) {
			int sum = 0;
			for(int j=0;j<c;j++) {
				sum += arr[i][j];
			}
			if(sum>max) {
				max=sum;
				row=i;
			}
		}
		System.out.println(row);
		sc.close();
	}

}
